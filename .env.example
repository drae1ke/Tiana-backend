NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrovet

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRE=8h
JWT_REFRESH_SECRET=replace-with-a-second-strong-secret
JWT_REFRESH_EXPIRE=7d

CLIENT_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=1

BASE_URL=http://localhost:5000
MPESA_ENV=sandbox
CONSUMER_KEY=your-mpesa-consumer-key
CONSUMER_SECRET=your-mpesa-consumer-secret
BUSINESS_SHORT_CODE=174379
PASSKEY=your-mpesa-passkey

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=alerts@example.com
EMAIL_PASS=replace-with-email-password
EMAIL_FROM="Tiana Agrovet <alerts@example.com>"
ALERT_EMAIL=owner@example.com

LOW_STOCK_CRON=0 8 * * *
EXPIRY_CHECK_CRON=0 7 * * *

API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
